global:
  scrape_interval: 15s
  evaluation_interval: 15s
  external_labels:
    monitor: 'hanihome-monitor'

rule_files:
  - "/etc/prometheus/rules/*.yml"

scrape_configs:
  # Prometheus 자체 메트릭
  - job_name: 'prometheus'
    static_configs:
      - targets: ['localhost:9090']
    scrape_interval: 30s
    metrics_path: /metrics

  # Loki 메트릭
  - job_name: 'loki'
    static_configs:
      - targets: ['hanihome-loki:3100']
    scrape_interval: 30s

  # Grafana 메트릭
  - job_name: 'grafana'
    static_configs:
      - targets: ['hanihome-grafana:3000']
    scrape_interval: 30s

  # 웹앱 서버 메트릭 (EC2 Instance 1) - 환경변수로 동적 설정
  - job_name: 'hanihome-server'
    static_configs:
      - targets: ['${API_SERVER_TARGET}:8080']
    scrape_interval: 15s
    metrics_path: /actuator/prometheus
    scrape_timeout: 10s

  # fluent-bit 메트릭 (EC2 Instance 1)
  - job_name: 'fluent-bit'
    static_configs:
      - targets: ['${API_SERVER_TARGET}:2020']
    scrape_interval: 30s
    metrics_path: /api/v1/metrics/prometheus

alerting:
  alertmanagers:
    - static_configs:
        - targets:
          # - alertmanager:9093